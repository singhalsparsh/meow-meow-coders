# ---------------------------------------------------------------------------
# Environment variables for coursecrafter (meow-meow-coders)
# Copy this to `.env.local` and fill in real values. NEVER commit `.env.local`.
# ---------------------------------------------------------------------------

# --- Clerk (Auth) ----------------------------------------------------------
# https://dashboard.clerk.com/last-active?path=api-keys
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...
# Optional: set to the custom redirect URLs you want
# NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
# NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# --- Database (Prisma / Postgres) ------------------------------------------
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL=postgresql://user:password@localhost:5432/coursecrafter?schema=public

# --- UploadThing (file uploads) --------------------------------------------
# https://uploadthing.com/dashboard
UPLOADTHING_TOKEN=...
# NEXT_PUBLIC_UPLOADTHING_APP_ID=...

# --- Stripe (payments) ------------------------------------------------------
# https://dashboard.stripe.com/test/apikeys
STRIPE_API_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# --- Mux (video hosting) -----------------------------------------------------
# https://dashboard.mux.com/settings/access-tokens
MUX_TOKEN_ID=...
MUX_TOKEN_SECRET=...
# MUX_WEBHOOK_SECRET=whsec_...
