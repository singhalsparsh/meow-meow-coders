datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

model Course {
  id          String  @id @default(uuid())
  userId      String
  title       String  @db.Text
  description String? @db.Text
  imageUrl    String? @db.Text
  price       Float?
  isPublished Boolean @default(false)

  categoryId String?
  category   Category? @relation(fields: [categoryId], references: [id])

  chapters    Chapter[]
  attachments Attachment[]
  purchases   Purchase[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([categoryId])
}

model Category {
  id      String   @id @default(uuid())
  name    String   @unique
  courses Course[]
}

model Attachment {
  id   String @id @default(uuid())
  name String
  url  String @db.Text

  courseId String
  course   Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([courseId])
}

model Chapter {
  id          String  @id @default(uuid())
  title       String
  description String? @db.Text
  videoUrl    String? @db.Text
  position    Int
  isPublished Boolean @default(false)
  isFree      Boolean @default(false)

  // Sub-lessons: a chapter with parentId = null is a top-level topic; a chapter
  // with a parentId is a sub-lesson nested under it. Only one level of
  // nesting is allowed; the API rejects a deeper chain.
  parentId    String?
  parent      Chapter?  @relation("SubChapters", fields: [parentId], references: [id], onDelete: Cascade)
  subChapters Chapter[] @relation("SubChapters")

  muxData MuxData?

  videoSources      VideoSource[]
  leetcodeQuestions LeetCodeQuestion[]
  pdfNotes          PdfNote[]
  codingProblems    CodingProblem[]

  courseId String
  course   Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  userProgress UserProgress[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([courseId])
  @@index([parentId])
}

model MuxData {
  id         String  @id @default(uuid())
  assetId    String
  playbackId String?

  chapterId String  @unique
  chapter   Chapter @relation(fields: [chapterId], references: [id], onDelete: Cascade)
}

model VideoSource {
  id       String  @id @default(uuid())
  src      String  @db.Text
  title    String?
  position Int     @default(0)

  chapterId String
  chapter   Chapter @relation(fields: [chapterId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([chapterId])
}

model UserProgress {
  id     String @id @default(uuid())
  userId String

  chapterId String
  chapter   Chapter @relation(fields: [chapterId], references: [id], onDelete: Cascade)

  isCompleted Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, chapterId])
  @@index([chapterId])
}

model Purchase {
  id     String @id @default(uuid())
  userId String

  courseId String
  course   Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, courseId])
  @@index([courseId])
}

model LeetCodeQuestion {
  id         String  @id @default(uuid())
  title      String
  url        String? @db.Text // external link (LeetCode etc.) — null for custom questions
  difficulty String // Easy, Medium, Hard
  tags       String? // comma-separated tags
  notes      String? @db.Text // teacher notes for students
  position   Int     @default(0)

  // Custom coding question fields (null for LeetCode link questions)
  problemStatement String? @db.Text
  testCases        String? @db.Text // JSON array of {input, expectedOutput, explanation?}
  solution         String? @db.Text

  chapterId String
  chapter   Chapter @relation(fields: [chapterId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([chapterId])
}

model PdfNote {
  id       String @id @default(uuid())
  title    String
  url      String @db.Text
  position Int    @default(0)

  chapterId String
  chapter   Chapter @relation(fields: [chapterId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([chapterId])
}

model StripeCustomer {
  id               String @id @default(uuid())
  userId           String @unique
  stripeCustomerId String @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum Difficulty {
  EASY
  MEDIUM
  HARD
}

enum DsaTopic {
  ARRAYS
  VECTORS
  STRINGS
  LINKED_LISTS
  STACKS
  QUEUES
  TREES
  GRAPHS
  DYNAMIC_PROGRAMMING
  SORTING_SEARCHING
  FUNDAMENTAL
  OTHER
}

enum SubmissionVerdict {
  ACCEPTED
  WRONG_ANSWER
  TIME_LIMIT_EXCEEDED
  COMPILE_ERROR
  RUNTIME_ERROR
}

model CodingProblem {
  id        String  @id @default(uuid())

  // A problem lives in exactly one place: a chapter lesson, or a standalone
  // test. Both columns are nullable but the API always sets exactly one.
  chapterId String?
  chapter   Chapter? @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  testId    String?
  test      Test?    @relation(fields: [testId], references: [id], onDelete: Cascade)

  title      String
  difficulty Difficulty @default(EASY)
  topic      DsaTopic   @default(ARRAYS)

  description String  @db.Text
  constraints String? @db.Text

  // Starter code provided to the student in Monaco Editor
  starterCode String @db.Text

  // Hidden wrapper code containing class definitions (e.g., ListNode, TreeNode),
  // input parsing, driver logic, and test harness execution
  driverCode String? @db.Text

  timeLimitMs Int @default(2000)

  // Ordering within a chapter, now that a chapter may hold several problems.
  position Int @default(0)

  testCases   TestCase[]
  submissions ProblemSubmission[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([chapterId])
  @@index([testId])
}

model TestCase {
  id        String        @id @default(uuid())
  problemId String
  problem   CodingProblem @relation(fields: [problemId], references: [id], onDelete: Cascade)

  input          String  @db.Text
  expectedOutput String  @db.Text
  explanation    String? @db.Text
  isHidden       Boolean @default(false)
  order          Int     @default(0)

  createdAt DateTime @default(now())
}

model ProblemSubmission {
  id        String        @id @default(uuid())
  userId    String
  problemId String
  problem   CodingProblem @relation(fields: [problemId], references: [id], onDelete: Cascade)

  code        String            @db.Text
  status      SubmissionVerdict
  passedCount Int
  totalCount  Int
  runtimeMs   Float?

  createdAt DateTime @default(now())

  @@index([userId, problemId])
}

// ---------------------------------------------------------------------------
// Standalone tests: a test is a self-contained assessment, independent of any
// course/chapter. It mixes auto-graded MCQs (single- or multi-correct) with the
// same coding problems used in lessons, graded by the same in-browser judge.

model Test {
  id          String  @id @default(uuid())
  userId      String
  title       String  @db.Text
  description String? @db.Text
  isPublished Boolean @default(false)

  mcqs     TestMcq[]
  problems CodingProblem[]
  attempts TestAttempt[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

// One multiple-choice question. `correctOptionIds` holds the ids of the correct
// options: exactly one entry => single-correct, several => multi-correct.
model TestMcq {
  id     String @id @default(uuid())
  testId String
  test   Test   @relation(fields: [testId], references: [id], onDelete: Cascade)

  question         String   @db.Text
  options          Json
  correctOptionIds Json
  explanation      String?  @db.Text
  position         Int      @default(0)

  answers TestAnswer[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([testId])
}

enum TestAttemptStatus {
  IN_PROGRESS
  SUBMITTED
}

// A learner`s sitting of one test. One per (test, user): re-opening a test
// resumes the in-progress attempt rather than starting a new one.
model TestAttempt {
  id     String @id @default(uuid())
  testId String
  test   Test   @relation(fields: [testId], references: [id], onDelete: Cascade)
  userId String

  status      TestAttemptStatus @default(IN_PROGRESS)
  score       Float             @default(0)
  maxScore    Float             @default(0)
  startedAt   DateTime          @default(now())
  submittedAt DateTime?

  answers TestAnswer[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([testId, userId])
  @@index([testId])
}

// A graded answer to one MCQ within an attempt. Coding problems are not stored
// here: their verdict comes from ProblemSubmission (same judge as lessons).
model TestAnswer {
  id        String @id @default(uuid())
  attemptId String
  attempt   TestAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)

  mcqId           String?
  mcq             TestMcq?   @relation(fields: [mcqId], references: [id], onDelete: Cascade)
  selectedOptionIds Json?
  isCorrect       Boolean    @default(false)
  awardedPoints   Float      @default(0)

  createdAt DateTime @default(now())

  @@unique([attemptId, mcqId])
  @@index([attemptId])
}
